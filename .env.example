# GEMINI_API_KEY: Optional. Enables the Gemini-backed Smopi AI agent.
# When unset the server falls back to a local (non-LLM) command engine.
# AI Studio injects this at runtime from user secrets; set it locally to test.
GEMINI_API_KEY=

# SHARE_PASSWORD: Password required to unlock and download files.
# Users configure this via the Settings menu or this environment variable.
SHARE_PASSWORD=

# OWNER_SESSION_SECRET: When set, owner-only actions (stop share, restart,
# password disclosure) require authenticating with this secret via
# POST /api/login-owner. When unset, the share runs in single-admin mode
# (anyone with the share password is the owner, as before).
OWNER_SESSION_SECRET=

# SHARE_DIR: Optional absolute path to the backing directory for shared files.
# Defaults to ./shared_files relative to the current working directory.
# SHARE_DIR=
